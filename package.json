{
  "name": "oraxaro",
  "version": "0.0.1",
  "description": "A visualization and reverse-engineering toolkit for Oracle Database",
  "author": "sajeevan",
  "type": "module",
  "private": true,
  "scripts": {
    "run:cli": "bun run src/index.ts",
    "run:watch": "bun run --watch src/index.ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "oracledb": "^6.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/oracledb": "^6.10.0",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "oracle",
    "database",
    "visualization",
    "database-internals"
  ],
  "bugs": {
    "url": "https://github.com/sajeevanjspy/OraxarO/issues"
  },
  "homepage": "https://github.com/sajeevanjspy/OraxarO#readme"
